# Znuny Instance Configuration
# Generated on {{SETUP_DATE}}
# This file contains all configuration and connection information for the instance

# =============================================================================
# INSTANCE INFORMATION
# =============================================================================

# Basic instance information
INSTANCE_NAME={{INSTANCE_NAME}}
SETUP_DATE={{SETUP_DATE}}

# Framework information
FRAMEWORK_DIR={{FRAMEWORK_DIR}}
FRAMEWORK_NAME={{FRAMEWORK_NAME}}
FRAMEWORK_BRANCH={{FRAMEWORK_BRANCH}}
FRAMEWORK_REPO_URL={{FRAMEWORK_REPO_URL}}

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Framework index (determines ports and network)
FRAMEWORK_INDEX={{FRAMEWORK_INDEX}}

# Port assignments (see DATABASE CONFIGURATION for DB_PORT)
INSTANCE_PORT={{INSTANCE_PORT}}

# Network configuration
NETWORK_SUBNET={{NETWORK_SUBNET}}
NETWORK_NAME=znuny_{{INSTANCE_NAME}}_network

# Access URLs
INSTANCE_URL=http://localhost:{{INSTANCE_PORT}}
INSTANCE_URL_PROXY=http://localhost/{{INSTANCE_NAME}}/
FQDN={{FQDN}}
ZNUNY_SCRIPT_ALIAS={{ZNUNY_SCRIPT_ALIAS}}

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database configuration (only one database type per instance)
DB_TYPE={{DB_TYPE}}
DB_HOST={{DB_HOST}}
DB_PORT={{DB_PORT}}

# Database-specific configuration (only for the selected DB type; block inserted by setup)
# {{DB_SPECIFIC_CONFIG}}

# =============================================================================
# ZNUNY CONFIGURATION
# =============================================================================

# Basic Znuny settings

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Instance mode: shared (host network, shared DB) or dedicated (own DB + network)
INSTANCE_MODE={{INSTANCE_MODE}}

# Container names
CONTAINER_NAME=znuny_{{INSTANCE_NAME}}_instance
DB_CONTAINER={{DB_CONTAINER}}

# Service names
SERVICE_NAME=znuny_{{INSTANCE_NAME}}_instance
DB_SERVICE={{DB_SERVICE}}

# Volume names
DATA_VOLUME=znuny_{{INSTANCE_NAME}}_data
LOGS_VOLUME=znuny_{{INSTANCE_NAME}}_logs
DB_VOLUME={{DB_VOLUME}}

# Compose file
COMPOSE_FILE={{COMPOSE_FILE_FULL_PATH}}

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Development tools (configured automatically based on available tools)

# =============================================================================
# MANAGEMENT COMMANDS
# =============================================================================

# Docker Compose commands
COMPOSE_CMD="docker-compose -p znuny -f {{COMPOSE_FILE}}"

# Instance management
START_CMD="{{COMPOSE_CMD}} up -d {{SERVICE_NAME}}"
STOP_CMD="{{COMPOSE_CMD}} stop {{SERVICE_NAME}}"
RESTART_CMD="{{COMPOSE_CMD}} restart {{SERVICE_NAME}}"
LOGS_CMD="{{COMPOSE_CMD}} logs -f {{SERVICE_NAME}}"

# Console access
CONSOLE_CMD="docker exec -it {{CONTAINER_NAME}} bash -c \"cd /opt/znuny && perl bin/znuny.Console.pl\""
