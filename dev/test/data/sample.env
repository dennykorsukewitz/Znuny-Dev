# Sample .env file for testing
# This file contains test data for environment variable testing

# =============================================================================
# ENVIRONMENT INFORMATION
# =============================================================================

SETUP_DATE=2024-01-15T10:30:00+0100
SETUP_ZD_ALIAS=true
SETUP_DIRECTORIES=true
SETUP_REPOSITORIES=true
SETUP_FRAMEWORK_INSTANCE=true

# =============================================================================
# FRAMEWORK INDEX MANAGEMENT
# =============================================================================

USED_FRAMEWORK_INDICES=0,1,2

# =============================================================================
# PROJECT PATHS
# =============================================================================

ZNUNY_DEV_DIR=/tmp/znuny-test
DEV_DIR=/tmp/znuny-test/dev
DOCKER_DIR=/tmp/znuny-test/dev/docker
SCRIPTS_DIR=/tmp/znuny-test/dev/scripts
ENV_DIR=/tmp/znuny-test/dev/env
INSTANCES_DIR=/tmp/znuny-test/dev/instances
COMPOSE_DIR=/tmp/znuny-test/dev/compose

# =============================================================================
# CORE DIRECTORIES
# =============================================================================

FRAMEWORKS_DIR=/tmp/znuny-test/frameworks
PACKAGES_DIR=/tmp/znuny-test/packages
TOOLS_DIR=/tmp/znuny-test/tools

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

DB_TYPE=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_NAME=znuny
DB_USER=znuny
DB_PASSWORD=znuny

# =============================================================================
# REPOSITORY SOURCES
# =============================================================================

REPO_SOURCE_ZNUNY=https://github.com/znuny/znuny.git
REPO_SOURCE_FRED=https://github.com/znuny/Fred.git
REPO_SOURCE_MODULE_TOOLS=https://github.com/znuny/module-tools.git
REPO_SOURCE_CODE_POLICY=https://github.com/znuny/ZnunyCodePolicy.git
