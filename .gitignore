# Znuny Development Environment
# Keep these directories empty in git - they will be populated by setup scripts

# Framework repositories (cloned by setup-repos)
# Keep directories but ignore all content except .gitkeep
!frameworks/.gitkeep
frameworks/*

# Package repositories (cloned by setup-repos)
# Keep directories but ignore all content except .gitkeep
!packages/.gitkeep
packages/*

# Developer tools (cloned by setup-repos)
# Keep directories but ignore all content except .gitkeep
!tools/.gitkeep
tools/*

# Instances (at project root, same level as dev/)
# Keep directories but ignore all content except .gitkeep
!instances/.gitkeep
instances/*

# Environment files
.env
!dev/docker/.env

# Docker volumes
docker/volumes/

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
.opener.pid
.supervisor.pid
.opener-wake
.DS_Store
Thumbs.db

# Editor / IDE
.cursor/

# Backup files
*.bak

# Configuration files
my.env

