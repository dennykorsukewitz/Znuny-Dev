# Sample instance .env file for testing
# This file contains test data for instance configuration testing

# =============================================================================
# INSTANCE INFORMATION
# =============================================================================

SETUP_DATE="2024-01-15 10:30:00"
INSTANCE_NAME=test
FRAMEWORK_DIR=/tmp/znuny-test/frameworks/test
FRAMEWORK_NAME=test
FRAMEWORK_BRANCH=dev
FRAMEWORK_REPO_URL=https://github.com/znuny/znuny.git
FRAMEWORK_INDEX=1

# =============================================================================
# PORT ASSIGNMENTS
# =============================================================================

INSTANCE_PORT=8081
DB_PORT=3306

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

NETWORK_SUBNET=172.20.2.0/24

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

DB_TYPE=mariadb
DB_HOST=znuny_test_mariadb
DB_CONTAINER=znuny_test_mariadb
DB_SERVICE=znuny_test_mariadb
DB_VOLUME=znuny_test_mariadb_data

# =============================================================================
# DOCKER COMPOSE CONFIGURATION
# =============================================================================

COMPOSE_FILE_FULL_PATH=/tmp/znuny-test/dev/compose/compose-test.yml
COMPOSE_FILE=/tmp/znuny-test/dev/compose/compose-test.yml
SERVICE_NAME=znuny_test_instance
CONTAINER_NAME=znuny_test_instance
COMPOSE_CMD="docker-compose -p znuny -f /tmp/znuny-test/dev/compose/compose-test.yml"

# =============================================================================
# DATABASE SPECIFIC CONFIGURATION
# =============================================================================

DB_NAME=test
DB_USER=test
DB_PASSWORD=test
MARIADB_ROOT_PASSWORD=root_test
