# Znuny Development Environment - Global Configuration Template
# This file serves as a template for the global .env file
# Generated automatically during setup-all and setup-env

# =============================================================================
# ENVIRONMENT INFORMATION
# =============================================================================

# Environment type and setup information
SETUP_DATE={{SETUP_DATE}}

# Setup completion flags
SETUP_ZD_ALIAS=false
SETUP_DIRECTORIES=false
SETUP_REPOSITORIES=false
SETUP_FRAMEWORK_INSTANCE=false

# =============================================================================
# FRAMEWORK INDEX MANAGEMENT
# =============================================================================

# Used framework indices (comma-separated list)
USED_FRAMEWORK_INDICES=

# =============================================================================
# PROJECT PATHS
# =============================================================================

# Main Znuny development root directory (where znuny-dev.sh is located)
ZNUNY_DEV_DIR={{ZNUNY_DEV_DIR}}

# Development directories (Full Paths)
DEV_DIR={{DEV_DIR}}
DOCKER_DIR={{DOCKER_DIR}}
SCRIPTS_DIR={{SCRIPTS_DIR}}
ENV_DIR={{ENV_DIR}}
INSTANCES_DIR={{INSTANCES_DIR}}
COMPOSE_DIR={{COMPOSE_DIR}}

# Development directories (Relative Paths)
DEV_DIR_REL={{DEV_DIR_REL}}
DOCKER_DIR_REL={{DOCKER_DIR_REL}}
SCRIPTS_DIR_REL={{SCRIPTS_DIR_REL}}
ENV_DIR_REL={{ENV_DIR_REL}}
INSTANCES_DIR_REL={{INSTANCES_DIR_REL}}
COMPOSE_DIR_REL={{COMPOSE_DIR_REL}}

# Core directories (Full Paths - can be outside of znuny-dev)
FRAMEWORKS_DIR={{FRAMEWORKS_DIR}}
PACKAGES_DIR={{PACKAGES_DIR}}
TOOLS_DIR={{TOOLS_DIR}}

# Core directories (Relative Paths)
FRAMEWORKS_DIR_REL={{FRAMEWORKS_DIR_REL}}
PACKAGES_DIR_REL={{PACKAGES_DIR_REL}}
TOOLS_DIR_REL={{TOOLS_DIR_REL}}

# Template Files (Full Paths)
GLOBAL_ENV_TEMPLATE={{GLOBAL_ENV_TEMPLATE}}
INSTANCE_ENV_TEMPLATE={{INSTANCE_ENV_TEMPLATE}}
DOCKER_ENV_TEMPLATE={{DOCKER_ENV_TEMPLATE}}

# Template Files (Relative Paths)
GLOBAL_ENV_TEMPLATE_REL={{GLOBAL_ENV_TEMPLATE_REL}}
INSTANCE_ENV_TEMPLATE_REL={{INSTANCE_ENV_TEMPLATE_REL}}
DOCKER_ENV_TEMPLATE_REL={{DOCKER_ENV_TEMPLATE_REL}}

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Default database settings (can be overridden by instance-specific .env files)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=znuny
DB_USER=znuny
DB_PASSWORD=znuny

# MySQL specific configuration
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=znuny
MYSQL_USER=znuny
MYSQL_PASSWORD=znuny

# PostgreSQL specific configuration (uncomment if using PostgreSQL)
POSTGRES_DB=znuny
POSTGRES_USER=znuny
POSTGRES_PASSWORD=znuny
# POSTGRES_ROOT_PASSWORD: postgres superuser for shared DB (like MARIADB_ROOT_PASSWORD). Falls back to POSTGRES_PASSWORD.

# MariaDB specific configuration (uncomment if using MariaDB)
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=znuny
MARIADB_USER=znuny
MARIADB_PASSWORD=znuny

# Oracle specific configuration (uncomment if using Oracle)
ORACLE_PASSWORD=oracle

# =============================================================================
# REPOSITORY SOURCES
# =============================================================================

# Default repository URLs
REPO_SOURCE_ZNUNY=https://github.com/znuny/znuny.git
REPO_SOURCE_FRED=https://github.com/znuny/Fred.git
REPO_SOURCE_MODULE_TOOLS=https://github.com/znuny/module-tools.git
REPO_SOURCE_CODE_POLICY=https://github.com/znuny/ZnunyCodePolicy.git

# =============================================================================
# DEVELOPMENT TOOLS PATHS
# =============================================================================

# Specific tool paths
FRED_DIR={{TOOLS_DIR}}/Fred
MODULE_TOOLS_DIR={{TOOLS_DIR}}/module-tools
CODE_POLICY_DIR={{TOOLS_DIR}}/ZnunyCodePolicy

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Docker compose settings
DOCKER_COMPOSE_PROJECT=znuny

# =============================================================================
# VERSION CHECK
# =============================================================================

# Last date (YYYY-MM-DD) when version was checked (set automatically)
ZD_LAST_VERSION_CHECK_DATE=

# =============================================================================
# CUSTOM CONFIGURATION
# =============================================================================

# Add your custom environment variables here
# CUSTOM_VAR=value
