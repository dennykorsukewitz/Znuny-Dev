
# ========================================
# Instance
# ========================================

# Base HTTP port for instances (default 10000)
# 1. instance = BASE_PORT
# 2. instance = BASE_PORT+1
# BASE_PORT=10000

# Default IDE for dashboard workspace button (cursor, code, vscode, idea, phpstorm, …)
# DEFAULT_IDE=code

# Linux/WSL: map container www-data to this UID so bind-mounted Git stays writable.
# Uncomment to pin; otherwise `zd start` uses `id -u` / `id -g`.
# HOST_UID=1000
# HOST_GID=1000

# ========================================
# My Repository URLs
# ========================================

REPO_SOURCE_ZNUNY=GIT-URL/Znuny.git
REPO_SOURCE_FRED=GIT-URL/Fred.git
REPO_SOURCE_MODULE_TOOLS=GIT-URL/module-tools.git
REPO_SOURCE_CODE_POLICY=GIT-URL/ZnunyCodePolicy.git
