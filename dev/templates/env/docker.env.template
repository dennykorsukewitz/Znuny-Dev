# Znuny Development Environment Configuration
# Copy this file to .env and modify the values as needed

# Database Configuration
# Choose one database type per instance
DB_TYPE={{DB_TYPE}}
DB_HOST={{DB_HOST}}
DB_PORT={{DB_PORT}}
DB_NAME={{DB_NAME}}
DB_USER={{DB_USER}}
DB_PASSWORD={{DB_PASSWORD}}

# MySQL specific configuration
MYSQL_ROOT_PASSWORD={{MYSQL_ROOT_PASSWORD}}
MYSQL_DATABASE={{MYSQL_DATABASE}}
MYSQL_USER={{MYSQL_USER}}
MYSQL_PASSWORD={{MYSQL_PASSWORD}}

# PostgreSQL specific configuration
POSTGRES_DB={{POSTGRES_DB}}
POSTGRES_USER={{POSTGRES_USER}}
POSTGRES_PASSWORD={{POSTGRES_PASSWORD}}

# MariaDB specific configuration
MARIADB_ROOT_PASSWORD={{MARIADB_ROOT_PASSWORD}}
MARIADB_DATABASE={{MARIADB_DATABASE}}
MARIADB_USER={{MARIADB_USER}}
MARIADB_PASSWORD={{MARIADB_PASSWORD}}

# Oracle specific configuration
ORACLE_PASSWORD={{ORACLE_PASSWORD}}

# Development Configuration
PACKAGE_DIR=packages
TOOLS_DIR=tools

# Development tools (configured automatically based on available tools)

# Selenium Configuration (optional)
ENABLE_SELENIUM=n
SELENIUM_HUB_URL=http://selenium-hub:4444
SELENIUM_BROWSER=chrome
SELENIUM_TIMEOUT=30
